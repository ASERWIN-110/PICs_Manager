# Copy to deploy/.env and edit for your NAS.

# UID/GID that owns the mounted NAS media directories.
PUID=1000
PGID=1000

# Host bind addresses. Keep 127.0.0.1 when access goes through Tailscale/reverse proxy on the NAS.
PICS_API_BIND=127.0.0.1
PICS_API_PORT=8080
PICS_WEB_BIND=127.0.0.1
PICS_WEB_PORT=5173

# Browser-visible API URL baked into the web image at build time.
# If clients access the NAS by Tailscale name/IP, set that URL here before building pics-web.
PICS_WEB_API_BASE_URL=http://127.0.0.1:8080/api/v1

# NAS media roots on the host.
PICS_MEDIA_ROOT=/srv/media
PICS_DATA_ROOT=./data

# Optional legacy maintenance token. New deployments should prefer security.enabled + pairing code.
PIC_MANAGER_MAINTENANCE_TOKEN=

# MongoDB database name used by PICs Manager.
DATABASE_NAME=media_manager

